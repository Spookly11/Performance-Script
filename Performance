-- Dragon mesh recoloring: matches any BasePart inside one of the three dragon
-- model roots, but explicitly skips eyes and teeth on all three dragons.
local DRAGON_ROOT_NAMES = {
    Dragon     = true,
    OtherDragon = true,
    RedDragon  = true,
}

-- Exact MeshPart names that must never be recolored regardless of which dragon
local DRAGON_MESH_DENY = {
    -- Eyes
    ["eyes.001"] = true,  -- RedDragon
    ["Eyes"]     = true,  -- Dragon
    ["Eyes.001"] = true,  -- OtherDragon

    -- Teeth and tooth outlines (RedDragon)
    ["UpperTeeth.005"]   = true,
    ["UpperTeeth.006"]   = true,
    ["LowrTeeth.005"]    = true,
    ["LowrTeeth.006"]    = true,

    -- Teeth and tooth outlines (Dragon)
    ["UpperTeeth"]        = true,
    ["LowrTeeth"]         = true,
    ["UpperTeethOutline"] = true,
    ["LowrTeethOutLine"]  = true,

    -- Teeth and tooth outlines (OtherDragon)
    ["UpperTeeth.001"]        = true,
    ["LowrTeeth.001"]         = true,
    ["UpperTeethOutline.001"] = true,
    ["LowrTeethOutLine.001"]  = true,
}

-- Returns true if obj is a descendant of one of the three dragon model roots
local function isInsideDragonRoot(obj)
    local ancestor = obj.Parent
    while ancestor do
        if DRAGON_ROOT_NAMES[ancestor.Name] then
            return true
        end
        ancestor = ancestor.Parent
    end
    return false
end

function isInMeshAllowlist(obj)
    -- Must be inside a known dragon model root
    if not isInsideDragonRoot(obj) then
        return false
    end
    -- Eyes and teeth are explicitly excluded
    if DRAGON_MESH_DENY[obj.Name] then
        return false
    end
    return true
end
