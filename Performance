local TextChatService = game:GetService("TextChatService")
local chatWindowConfiguration = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
local customChatInstalled = false
local customChatWrapper = nil
local customChatPreviousCallback = nil
local customChatMonitorRunning = false
local customChatSession = 0

local function installCustomChatColor()
    if customChatInstalled or not enabled.m1color or unloaded then
        return
    end

    customChatSession += 1
    local session = customChatSession

    chatWindowConfiguration =
        chatWindowConfiguration
        or TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")

    if not chatWindowConfiguration then
        task.spawn(function()
            local cfg = TextChatService:WaitForChild("ChatWindowConfiguration", 10)
            if session ~= customChatSession or not enabled.m1color or unloaded then
                return
            end

            chatWindowConfiguration = cfg
            if chatWindowConfiguration then
                installCustomChatColor()
            end
        end)
        return
    end

    local ok, existingCallback = pcall(function()
        return TextChatService.OnChatWindowAdded
    end)

    if ok and existingCallback ~= customChatWrapper then
        customChatPreviousCallback = existingCallback
    else
        customChatPreviousCallback = nil
    end

    customChatWrapper = function(message)
        if not enabled.m1color or unloaded then
            return nil
        end

        -- Never return a ChatWindowMessageProperties object for other players.
        -- That lets Roblox keep its native username/team color and formatting.
        if not message
            or not message.TextSource
            or message.TextSource.UserId ~= LocalPlayer.UserId then
            return nil
        end

        local cfg = chatWindowConfiguration
            or TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")

        local properties

        -- Start with the game's existing callback if one exists.
        if customChatPreviousCallback then
            local callbackOk, result = pcall(customChatPreviousCallback, message)
            if callbackOk
                and typeof(result) == "Instance"
                and result:IsA("ChatWindowMessageProperties") then
                properties = result
            end
        end

        -- If the game does not provide a callback result, derive the normal
        -- message properties so the chat keeps its standard appearance.
        if not properties and cfg then
            local deriveOk, derived = pcall(function()
                return cfg:DeriveNewMessageProperties()
            end)
            if deriveOk and derived then
                properties = derived
            end
        end

        if not properties then
            local createOk, created = pcall(function()
                return Instance.new("ChatWindowMessageProperties")
            end)
            if createOk then
                properties = created
            end
        end

        if not properties then
            return nil
        end

        -- Recolor both the display name prefix and the message body.
        local prefixProperties
        if cfg then
            local prefixOk, derivedPrefix = pcall(function()
                return cfg:DeriveNewMessageProperties()
            end)
            if prefixOk and derivedPrefix then
                prefixProperties = derivedPrefix
            end
        end

        if not prefixProperties then
            local prefixOk, fallbackPrefix = pcall(function()
                return Instance.new("ChatWindowMessageProperties")
            end)
            if prefixOk then
                prefixProperties = fallbackPrefix
            end
        end

        if prefixProperties then
            prefixProperties.TextColor3 = currentM1Color
            properties.PrefixTextProperties = prefixProperties
        end

        properties.TextColor3 = currentM1Color

        return properties
    end

    local setOk = pcall(function()
        TextChatService.OnChatWindowAdded = customChatWrapper
    end)

    customChatInstalled = setOk

    if not setOk then
        customChatWrapper = nil
        customChatPreviousCallback = nil
        return
    end

    if not customChatMonitorRunning then
        customChatMonitorRunning = true
        task.spawn(function()
            while customChatMonitorRunning and enabled.m1color and not unloaded do
                task.wait(1)
                if not customChatMonitorRunning or not enabled.m1color or unloaded then
                    break
                end

                local pollOk, current = pcall(function()
                    return TextChatService.OnChatWindowAdded
                end)

                if pollOk and current ~= customChatWrapper then
                    customChatMonitorRunning = false
                    customChatInstalled = false
                    installCustomChatColor()
                    break
                end
            end
        end)
    end
end

local function uninstallCustomChatColor()
    -- Invalidate any pending WaitForChild/install task before restoring the
    -- callback. This prevents the hook from coming back after the toggle is off.
    customChatSession += 1
    customChatMonitorRunning = false

    local wrapper = customChatWrapper
    local previous = customChatPreviousCallback

    pcall(function()
        if wrapper and TextChatService.OnChatWindowAdded == wrapper then
            TextChatService.OnChatWindowAdded = previous
        end
    end)

    customChatWrapper = nil
    customChatPreviousCallback = nil
    customChatInstalled = false
end

local function isCustomColorUIObject(obj)
    if not obj or not obj.Parent then
        return false
    end

    -- Never touch CosmicFrames or anything inside them.
    local ancestor = obj
    while ancestor do
        if ancestor.Name == "CosmicFrames" then
            return false
        end
        ancestor = ancestor.Parent
    end

    if (obj:IsA("ImageLabel") or obj:IsA("ImageButton"))
        and obj.Image == CUSTOM_AWAKENING_BAR_IMAGE then
        return "Awakening"
    end

    if obj:IsA("Frame") and obj.Name == "Cooldown" then
        -- The move hotbar cooldown has an Overlay sibling.
        if obj.Parent and obj.Parent:FindFirstChild("Overlay") then
            return "MoveCooldown"
        end
    end

    if obj:IsA("Frame") and obj.Name == "Fill" then
        -- The supplied dash/evasive/burst indicator script creates these under
        -- the cooldown holder or the burst holder.
        local parent = obj.Parent
        while parent do
            if parent.Name == "cdholder" then
                return "DashCooldown"
            end
            if parent.Name == "burster" then
                return "Burst"
            end
            parent = parent.Parent
        end
    end

    return false
end

local function getCustomColorForUIKind(kind)
    if kind == "Awakening" then
        return currentM1Color
    elseif kind == "MoveCooldown" then
        return currentM1Color
    elseif kind == "DashCooldown" then
        return currentM1Color
    elseif kind == "Burst" then
        return currentM1Color
    end
    return currentM1Color
end

local function captureCustomColorUIBaseline(obj, prop)
    if not obj or not obj.Parent then
        return
    end

    customColorUIBaselines[obj] = customColorUIBaselines[obj] or {}
    if customColorUIBaselines[obj][prop] == nil then
        customColorUIBaselines[obj][prop] = obj[prop]
    end
end

local function cacheCustomColorUIObject(obj, prop)
    if not obj or not obj.Parent then
        return
    end

    -- The baseline must be captured before the custom color is applied.
    captureCustomColorUIBaseline(obj, prop)

    customColorUIObjects[obj] = true
    customColorUIOriginals[obj] = customColorUIOriginals[obj] or {}

    if customColorUIOriginals[obj][prop] == nil then
        customColorUIOriginals[obj][prop] = customColorUIBaselines[obj][prop]
    end
end

local function applyCustomColorToUIObject(obj)
    if not VFXConfig.Enabled or not obj or not obj.Parent then
        return
    end

    local kind = isCustomColorUIObject(obj)
    if not kind then
        return
    end

    pcall(function()
        if kind == "Awakening" then
            cacheCustomColorUIObject(obj, "ImageColor3")
            obj.ImageColor3 = currentM1Color
        else
            cacheCustomColorUIObject(obj, "BackgroundColor3")
            obj.BackgroundColor3 = currentM1Color
        end
    end)
end

local function disconnectCustomColorUI()
    for _, conn in ipairs(customColorUIConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(customColorUIConnections)

    for _, conn in ipairs(customColorUIRootConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(customColorUIRootConnections)
end

local function captureAllCustomColorUIBaselines()
    if not PlayerGui then
        return
    end

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        local kind = isCustomColorUIObject(obj)
        if kind then
            local prop = (kind == "Awakening") and "ImageColor3" or "BackgroundColor3"
            captureCustomColorUIBaseline(obj, prop)
        end
    end
end

local function restoreCustomColorUI()
    -- Restore every currently existing matching UI object to its previously
    -- captured baseline. Do NOT capture a baseline here: if the game rebuilt an
    -- object while Custom Colors was enabled, its current color may already be
    -- the custom color, and capturing it now would make that color permanent.
    if PlayerGui then
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            local kind = isCustomColorUIObject(obj)
            if kind then
                local prop = (kind == "Awakening") and "ImageColor3" or "BackgroundColor3"
                local baseline = customColorUIBaselines[obj]
                if baseline and baseline[prop] ~= nil then
                    pcall(function()
                        obj[prop] = baseline[prop]
                    end)
                end
            end
        end
    end

    -- Also restore tracked objects that may no longer be discoverable through
    -- the current hierarchy scan but are still alive.
    for obj in pairs(customColorUIObjects) do
        local baseline = customColorUIBaselines[obj] or customColorUIOriginals[obj]
        if baseline and obj and obj.Parent then
            pcall(function()
                for prop, originalValue in pairs(baseline) do
                    obj[prop] = originalValue
                end
            end)
        end
    end

    table.clear(customColorUIObjects)
    table.clear(customColorUIOriginals)
end

local function watchCustomColorUIRoot(root, sessionId)
    if not root or not VFXConfig.Enabled or sessionId ~= customColorUISession then
        return
    end

    for _, obj in ipairs(root:GetDescendants()) do
        if not VFXConfig.Enabled or sessionId ~= customColorUISession then
            return
        end
        local kind = isCustomColorUIObject(obj)
        if kind then
            local prop = (kind == "Awakening") and "ImageColor3" or "BackgroundColor3"
            captureCustomColorUIBaseline(obj, prop)
        end
        applyCustomColorToUIObject(obj)
    end

    local conn = root.DescendantAdded:Connect(function(obj)
        if not VFXConfig.Enabled or sessionId ~= customColorUISession then
            return
        end
        local kind = isCustomColorUIObject(obj)
        if kind then
            local prop = (kind == "Awakening") and "ImageColor3" or "BackgroundColor3"
            captureCustomColorUIBaseline(obj, prop)
        end
        applyCustomColorToUIObject(obj)
    end)
    table.insert(customColorUIRootConnections, conn)
end

local function startCustomColorUIWatcher()
    disconnectCustomColorUI()
    restoreCustomColorUI()

    customColorUISession += 1
    local sessionId = customColorUISession

    if not VFXConfig.Enabled then
        return
    end

    watchCustomColorUIRoot(PlayerGui, sessionId)

    -- The hotbar/ultimate UI can be rebuilt when the character changes.
    local conn = LocalPlayer.CharacterAdded:Connect(function()
        if not VFXConfig.Enabled or sessionId ~= customColorUISession then
            return
        end

        task.wait(0.5)

        if VFXConfig.Enabled and sessionId == customColorUISession then
            watchCustomColorUIRoot(PlayerGui, sessionId)
        end
    end)
    table.insert(customColorUIConnections, conn)

    -- Game code can change these properties after creation (for example when
    -- Burst reaches 100%). Re-apply the selected custom color while enabled.
    local tracked = {}
    local function trackObject(obj)
        if tracked[obj] then
            return
        end

        local kind = isCustomColorUIObject(obj)
        if not kind then
            return
        end

        tracked[obj] = true

        local prop = (kind == "Awakening") and "ImageColor3" or "BackgroundColor3"
        captureCustomColorUIBaseline(obj, prop)
        local propertyConn = obj:GetPropertyChangedSignal(prop):Connect(function()
            if not VFXConfig.Enabled or sessionId ~= customColorUISession then
                return
            end

            if obj.Parent and isCustomColorUIObject(obj) then
                local wanted = getCustomColorForUIKind(kind)
                if obj[prop] ~= wanted then
                    obj[prop] = wanted
                end
            end
        end)

        table.insert(customColorUIConnections, propertyConn)
        applyCustomColorToUIObject(obj)
    end

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        trackObject(obj)
    end

    local rootTrackConn = PlayerGui.DescendantAdded:Connect(function(obj)
        if not VFXConfig.Enabled or sessionId ~= customColorUISession then
            return
        end

        -- Apply immediately, then hook the property so game updates cannot
        -- overwrite the custom color during the active session.
        trackObject(obj)
        for _, child in ipairs(obj:GetDescendants()) do
            trackObject(child)
        end
    end)
    table.insert(customColorUIConnections, rootTrackConn)
end

local function stopCustomColorUIWatcher()
    customColorUISession += 1
    disconnectCustomColorUI()
    restoreCustomColorUI()
end

function refreshActiveCustomColors()
    if not VFXConfig.Enabled then
        return
    end

    VFXConfig.TargetColor = currentM1Color
    refreshActiveVFXColor()

    for obj in pairs(customColorUIObjects) do
        if obj and obj.Parent then
            applyCustomColorToUIObject(obj)
        end
    end

    -- Catch UI elements that were rebuilt without firing a useful descendant
    -- callback before the color was applied.
    if PlayerGui then
        for _, obj in ipairs(PlayerGui:GetDescendants()) do
            applyCustomColorToUIObject(obj)
        end
    end
end

function applyM1TrailColor(useCustom)
    if useCustom then
        VFXConfig.TargetColor = currentM1Color
        VFXConfig.Enabled = true
        startVFXWatcher()
        startCustomColorUIWatcher()
        installCustomChatColor()
    else
        stopVFXWatcher()
        stopCustomColorUIWatcher()
        uninstallCustomChatColor()
    end
end

