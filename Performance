m1FavoriteColors = {}
if type(savedPrefs.m1FavoriteColors) == "table" then
    for _, hex in ipairs(savedPrefs.m1FavoriteColors) do
        if type(hex) == "string" and hexToColor3(hex) and #m1FavoriteColors < 7 then
            table.insert(m1FavoriteColors, string.upper(hex))
        end
    end
end

function persistM1FavoriteColors()
    savedPrefs.m1FavoriteColors = {}
    for _, hex in ipairs(m1FavoriteColors) do
        table.insert(savedPrefs.m1FavoriteColors, hex)
    end
    savePrefs(savedPrefs)
end

function isM1Favorite(hex)
    hex = string.upper(hex)
    for _, favorite in ipairs(m1FavoriteColors) do
        if string.upper(favorite) == hex then
            return true
        end
    end
    return false
end

function addM1Favorite(hex)
    hex = string.upper(hex)
    if isM1Favorite(hex) or #m1FavoriteColors >= 7 then
        return false
    end
    table.insert(m1FavoriteColors, hex)
    persistM1FavoriteColors()
    return true
end

function removeM1Favorite(hex)
    hex = string.upper(hex)
    for i = #m1FavoriteColors, 1, -1 do
        if string.upper(m1FavoriteColors[i]) == hex then
            table.remove(m1FavoriteColors, i)
            persistM1FavoriteColors()
            return true
        end
    end
    return false
end

function makeColorTooltip(parent, text, width)
