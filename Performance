local function getAwakeningPercentage()
    local character = LocalPlayer.Character
    if not character then
        return 0, false
    end

    local ulted = character:GetAttribute("Ulted") == true

    if ulted then
        local primaryPart = character.PrimaryPart
        local fill = primaryPart and primaryPart:GetAttribute("fill")

        if type(fill) == "number" then
            return math.clamp(fill, 0, 1) * 100, true
        end

        -- If the awakening is active but no draining fill value exists,
        -- keep the display at 100% rather than incorrectly showing 0%.
        return 100, true
    end

    return LocalPlayer:GetAttribute("Ultimate") or 0, false
end

