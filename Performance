function refreshM1FavoritesDropdown()
    for _, child in ipairs(m1FavoritesDropdown:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local swatchWidth = 32
    local swatchGap = 4
    local rowHeight = 26

    for index, hex in ipairs(m1FavoriteColors) do
        local color = hexToColor3(hex)
        local button = Instance.new("TextButton")
        button.Name = "Favorite" .. index
        button.Position = UDim2.new(0, 4 + (index - 1) * (swatchWidth + swatchGap), 0, 2)
        button.Size = UDim2.new(0, swatchWidth, 0, 22)
