function antiAFKPulse()
    if not enabled.antiafk or unloaded then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local ok = pcall(function()
        if not antiAfkVirtualUser then
            antiAfkVirtualUser = game:GetService("VirtualUser")
        end

        antiAfkVirtualUser:CaptureController()

        local position = Vector2.new(0, 0)
        antiAfkVirtualUser:Button2Down(position, camera.CFrame)
        task.wait(0.15)
        antiAfkVirtualUser:Button2Up(position, camera.CFrame)
    end)

    if ok then
        antiAfkLastAction = os.clock()
    end
end

function startAntiAFK()

    antiAfkRunning = false

    if antiAfkIdleConnection then
        pcall(function() antiAfkIdleConnection:Disconnect() end)
        antiAfkIdleConnection = nil
    end

    antiAfkLastAction = os.clock()
    antiAfkVirtualUser = game:GetService("VirtualUser")


    antiAfkIdleConnection = LocalPlayer.Idled:Connect(function()
        if not enabled.antiafk or unloaded then return end
        antiAFKPulse()
    end)

    antiAfkRunning = true
    antiAfkConnection = task.spawn(function()
        while antiAfkRunning and not unloaded do
            task.wait(60)
            if antiAfkRunning and not unloaded then

                if os.clock() - antiAfkLastAction >= 55 then
                    antiAFKPulse()
                end
            end
        end
    end)
end

function stopAntiAFK()
    antiAfkRunning = false
    antiAfkConnection = nil

    if antiAfkIdleConnection then
        pcall(function() antiAfkIdleConnection:Disconnect() end)
        antiAfkIdleConnection = nil
    end

    antiAfkVirtualUser = nil
end

function applyAntiAFK(on)
    if on then
        startAntiAFK()
    else
        stopAntiAFK()
    end
end

