function updatePingGraph()
    local ping = getPing()
    -- Shift history left, append latest sample
    table.remove(pingHistory, 1)
    table.insert(pingHistory, ping)

    local CEIL = 200  -- ms ceiling for graph scaling
    local barW = GRAPH_W / GRAPH_SAMPLES

    -- Compute bar heights and colours, cache y-fractions for line segments
    local yFracs = {}
    for i = 1, GRAPH_SAMPLES do
        local p = pingHistory[i]
        local frac = math.min(p / CEIL, 1)
        yFracs[i] = frac
        local bar = pingGraphBars[i]
        bar.Size     = UDim2.new(0, math.max(1, barW - 1), frac, 0)
        bar.Position = UDim2.new(0, (i - 1) * barW, 1, 0)
        bar.BackgroundColor3 = getPingColor(p)
        bar.BackgroundTransparency = p == 0 and 1 or 0.55
    end

    -- Update line segments connecting adjacent bar tops
    for i = 1, GRAPH_SAMPLES - 1 do
        local seg = pingGraphLineSegs[i]
        local f1 = yFracs[i]
        local f2 = yFracs[i + 1]
        if pingHistory[i] == 0 or pingHistory[i + 1] == 0 then
            seg.Size = UDim2.new(0, 0, 0, 0)
        else
            local x1 = (i - 1) * barW + barW * 0.5
            local x2 = i * barW + barW * 0.5
            local y1 = GRAPH_H * (1 - f1)
            local y2 = GRAPH_H * (1 - f2)
            local dx = x2 - x1
            local dy = y2 - y1
            local len = math.sqrt(dx * dx + dy * dy)
            local angle = math.deg(math.atan2(dy, dx))
            local cx = (x1 + x2) * 0.5
            local cy = (y1 + y2) * 0.5
            seg.Position  = UDim2.new(0, cx, 0, cy)
            seg.Size      = UDim2.new(0, len, 0, 1)
            seg.Rotation  = angle
            seg.AnchorPoint = Vector2.new(0.5, 0.5)
        end
    end
end
