cachedOriginalProps = {}
touchedVFXObjects = {}
vfxWatchConnections = {}
vfxSessionId = 0

function cacheOriginal(obj, prop)
    if not obj or not obj.Parent then
        return
    end

    cachedOriginalProps[obj] = cachedOriginalProps[obj] or {}
    touchedVFXObjects[obj] = true

    if cachedOriginalProps[obj][prop] == nil then
        cachedOriginalProps[obj][prop] = obj[prop]
    end
end

function sanitizeColor3(color)
    if typeof(color) ~= "Color3" then
        return Color3.new(1, 1, 1)
    end

    local r = tonumber(color.R) or 1
    local g = tonumber(color.G) or 1
    local b = tonumber(color.B) or 1

    if r ~= r or r == math.huge or r == -math.huge then r = 1 end
    if g ~= g or g == math.huge or g == -math.huge then g = 1 end
    if b ~= b or b == math.huge or b == -math.huge then b = 1 end

    return Color3.new(
        math.clamp(r, 0, 1),
        math.clamp(g, 0, 1),
        math.clamp(b, 0, 1)
    )
end

function safeToHSV(color)
    local safe = sanitizeColor3(color)

    local ok, h, s, v = pcall(function()
        return safe:ToHSV()
    end)

    if not ok then
        return 0, 0, 1
    end

    if h ~= h or h == math.huge or h == -math.huge then h = 0 end
    if s ~= s or s == math.huge or s == -math.huge then s = 0 end
    if v ~= v or v == math.huge or v == -math.huge then v = 1 end

    return math.clamp(h, 0, 1), math.clamp(s, 0, 1), math.clamp(v, 0, 1)
end

function isGrayscale(color)
    local _, s, _ = safeToHSV(color)
    return s < VFXConfig.GrayscaleSaturationThreshold
end

function transformColor(color)
    color = sanitizeColor3(color)

    if VFXConfig.Mode == "Full" then
        return sanitizeColor3(VFXConfig.TargetColor)
    end

    if VFXConfig.PreserveGrayscale and isGrayscale(color) then
        return color
    end

    local targetH, targetS, _ = safeToHSV(VFXConfig.TargetColor)
    local _, _, v = safeToHSV(color)

    local ok, result = pcall(function()
        return Color3.fromHSV(
            math.clamp(targetH, 0, 1),
            math.clamp(targetS, 0, 1),
            math.clamp(v, 0, 1)
        )
    end)

    if ok and typeof(result) == "Color3" then
        return result
    end

    return color
end

function transformColorSequence(sequence)
    local newKeypoints = {}

    for _, kp in ipairs(sequence.Keypoints) do
        table.insert(
            newKeypoints,
            ColorSequenceKeypoint.new(kp.Time, transformColor(kp.Value))
        )
    end

    return ColorSequence.new(newKeypoints)
end

-- Build a fast lookup set for shared VFX folder names
local VFX_WATCH_ROOT_SET = {}
for _, name in ipairs(VFX_WATCH_ROOT_NAMES) do
    VFX_WATCH_ROOT_SET[name] = true
end

function isOwnedByLocalPlayer(obj)
    local ancestor = obj
    while ancestor do

        -- Direct character match: definitely ours
        if ancestor == LocalPlayer.Character then
            return true
        end

        -- If this ancestor IS another player's character, reject immediately
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and ancestor == player.Character then
                return false
            end
        end

        -- Reached a direct child of workspace
        if ancestor.Parent == workspace then
            if VFX_WATCH_ROOT_SET[ancestor.Name] then
                -- This is a shared VFX folder (Live, Thrown, etc.)
                -- No other player's character was found on the way up, so allow it
                return true
            end

            -- Otherwise it must be our own character to be allowed
            local char = LocalPlayer.Character
            if char then
                return ancestor == char
            end
            -- No character loaded yet -- reject to be safe
            return false
        end

        ancestor = ancestor.Parent
    end
    return false
end

function recolorObject(obj)
    if not VFXConfig.Enabled or not obj or not obj.Parent then
        return false
    end


    if not isOwnedByLocalPlayer(obj) then
        return false
    end

    local ok = pcall(function()
        if not VFXConfig.Enabled then
            return
        end

        if obj:IsA("ParticleEmitter") and VFXConfig.RecolorParticles then
            cacheOriginal(obj, "Color")
            obj.Color = transformColorSequence(cachedOriginalProps[obj].Color)
            obj:Clear()

        elseif obj:IsA("Trail") and VFXConfig.RecolorTrails then
            cacheOriginal(obj, "Color")
            obj.Color = transformColorSequence(cachedOriginalProps[obj].Color)

        elseif obj:IsA("Beam") and VFXConfig.RecolorBeams then
            cacheOriginal(obj, "Color")
            obj.Color = transformColorSequence(cachedOriginalProps[obj].Color)

        elseif (obj:IsA("PointLight")
            or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight"))
            and VFXConfig.RecolorLights then

            cacheOriginal(obj, "Color")
            obj.Color = transformColor(cachedOriginalProps[obj].Color)

        elseif obj:IsA("Highlight") and VFXConfig.RecolorHighlights then
            cacheOriginal(obj, "FillColor")
            cacheOriginal(obj, "OutlineColor")

            obj.FillColor = transformColor(cachedOriginalProps[obj].FillColor)
            obj.OutlineColor = transformColor(cachedOriginalProps[obj].OutlineColor)

        elseif obj:IsA("Decal")
            and (VFXConfig.RecolorDecals or isInDecalAllowlist(obj)) then

            cacheOriginal(obj, "Color3")
            obj.Color3 = transformColor(cachedOriginalProps[obj].Color3)

        elseif obj:IsA("BasePart")
            and VFXConfig.RecolorMeshes
            and isInMeshAllowlist(obj) then

            cacheOriginal(obj, "Color")
            obj.Color = transformColor(cachedOriginalProps[obj].Color)
        end
    end)

    return ok
end

function restoreAllVFX()
    for obj in pairs(touchedVFXObjects) do
        local cache = cachedOriginalProps[obj]

        if cache and obj and obj.Parent then
            pcall(function()
                for prop, originalValue in pairs(cache) do
                    obj[prop] = originalValue
                end

                if obj:IsA("ParticleEmitter") then
                    obj:Clear()
                end
            end)
        end
    end

    table.clear(touchedVFXObjects)
    table.clear(cachedOriginalProps)
end

function disconnectVFXWatchers()
    for _, conn in ipairs(vfxWatchConnections) do
        pcall(function()
            conn:Disconnect()
        end)
    end

    table.clear(vfxWatchConnections)
end

function scanAndWatch(root, sessionId)
    if not VFXConfig.Enabled or sessionId ~= vfxSessionId then
        return
    end

    for _, obj in ipairs(root:GetDescendants()) do
        if not VFXConfig.Enabled or sessionId ~= vfxSessionId then
            return
        end

        recolorObject(obj)
    end

    local connection = root.DescendantAdded:Connect(function(obj)
        if not VFXConfig.Enabled or sessionId ~= vfxSessionId then
            return
        end

        recolorObject(obj)
    end)

    table.insert(vfxWatchConnections, connection)
end

function getVFXWatchRoots()
    local roots = {}

    if LocalPlayer.Character then
        table.insert(roots, LocalPlayer.Character)
    end

    for _, name in ipairs(VFX_WATCH_ROOT_NAMES) do
        local folder = workspace:FindFirstChild(name)

        if folder then
            table.insert(roots, folder)
        end
    end

    return roots
end

function startVFXWatcher()
    disconnectVFXWatchers()

    vfxSessionId += 1
    local thisSession = vfxSessionId

    if not VFXConfig.Enabled then
        return
    end

    table.clear(touchedVFXObjects)
    table.clear(cachedOriginalProps)

    for _, root in ipairs(getVFXWatchRoots()) do
        if not VFXConfig.Enabled or thisSession ~= vfxSessionId then
            return
        end

        scanAndWatch(root, thisSession)
    end
end

function stopVFXWatcher()
    vfxSessionId += 1

    VFXConfig.Enabled = false

    disconnectVFXWatchers()
    restoreAllVFX()
end

function refreshActiveVFXColor()
    if not VFXConfig.Enabled then
        return
    end

    VFXConfig.TargetColor = currentM1Color

    for obj in pairs(touchedVFXObjects) do
        if obj and obj.Parent then
            recolorObject(obj)
        end
    end

    for _, root in ipairs(getVFXWatchRoots()) do
        if not VFXConfig.Enabled then
            return
        end

        for _, obj in ipairs(root:GetDescendants()) do
            if not VFXConfig.Enabled then
                return
            end

            recolorObject(obj)
        end
    end
end

