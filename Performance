function antiAFKPulse()
    if not enabled.antiafk or unloaded then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local ok = pcall(function()
        if not antiAfkVirtualUser then
            antiAfkVirtualUser = game:GetService("VirtualUser")
        end

        antiAfkVirtualUser:CaptureController()

        local position = Vector2.new(0, 0)
        antiAfkVirtualUser:Button2Down(position, camera.CFrame)
        task.wait(0.15)
        antiAfkVirtualUser:Button2Up(position, camera.CFrame)
    end)

    if ok then
        antiAfkLastAction = os.clock()
    end
end

function startAntiAFK()

    antiAfkRunning = false

    if antiAfkIdleConnection then
        pcall(function() antiAfkIdleConnection:Disconnect() end)
        antiAfkIdleConnection = nil
    end

    antiAfkLastAction = os.clock()
    antiAfkVirtualUser = game:GetService("VirtualUser")


    antiAfkIdleConnection = LocalPlayer.Idled:Connect(function()
        if not enabled.antiafk or unloaded then return end
        antiAFKPulse()
    end)

    antiAfkRunning = true
    antiAfkConnection = task.spawn(function()
        while antiAfkRunning and not unloaded do
            task.wait(60)
            if antiAfkRunning and not unloaded then

                if os.clock() - antiAfkLastAction >= 55 then
                    antiAFKPulse()
                end
            end
        end
    end)
end

function stopAntiAFK()
    antiAfkRunning = false
    antiAfkConnection = nil

    if antiAfkIdleConnection then
        pcall(function() antiAfkIdleConnection:Disconnect() end)
        antiAfkIdleConnection = nil
    end

    antiAfkVirtualUser = nil
end

function applyAntiAFK(on)
    if GAME_FEATURES_LOCKED then
        on = false
    end
    if on then
        startAntiAFK()
    else
        stopAntiAFK()
    end
end

-- ── Player ESP ─────────────────────────────────────────────────────────────
-- Screen-space ESP: tracer lines and a single rectangular hitbox marker.
-- The hitbox is ONE Frame with ONE UIStroke, so it cannot have individual
-- corner/line objects drifting out of sync.

local espTracerGui = nil
local espPlayerConnections = {}
local espObjects = {}
local espRenderConnection = nil

local ESP_TRACER_TRANSPARENCY = 0.55
local ESP_TRACER_THICKNESS    = 1
local ESP_BOX_THICKNESS       = 1
local ESP_BOX_SCALE            = 1.5

local function getESPColor(player)
    return (player and player.TeamColor and player.TeamColor.Color)
        or Color3.fromRGB(255, 0, 0)
end

local function disconnectESPConnection(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function getTracerRoot(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("Head")
end

local function getCharacterBodyBounds(character)
    if not character then return nil end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not root:IsA("BasePart") then
        return nil
    end

    -- Use the HumanoidRootPart as the center and the Humanoid's body
    -- dimensions rather than scanning every animated/accessory part.
    local bodyWidth = root.Size.X
    local bodyDepth = root.Size.Z
    local bodyHeight = root.Size.Y

    if humanoid then
        -- These describe the character's intended body scale and do not
        -- expand when an animation moves a limb or accessory.
        local hipHeight = humanoid.HipHeight

        if typeof(hipHeight) == "number" and hipHeight > 0 then
            bodyHeight = math.max(bodyHeight, hipHeight * 2)
        end
    end

    local halfX = math.max(bodyWidth * 0.5, 1)
    local halfZ = math.max(bodyDepth * 0.5, 1)
    local halfY = math.max(bodyHeight * 0.5, 1)

    local center = root.Position

    return (
        center - Vector3.new(halfX, halfY, halfZ)
    ), (
        center + Vector3.new(halfX, halfY, halfZ)
    )
end

-- ONE Frame represents the complete hitbox.
-- UIStroke is attached to that Frame, rather than using separate sides.
local function makeBox(parent, color)
    local box = Instance.new("Frame")
    box.Name = "ESPBox"
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.ZIndex = 3
    box.Visible = false
    box.Parent = parent

    local stroke = Instance.new("UIStroke")
    stroke.Name = "ESPBoxStroke"
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Thickness = ESP_BOX_THICKNESS
    stroke.Transparency = 0
    stroke.Color = color
    stroke.Parent = box

    box:SetAttribute("ESPBox", true)

    return box
end

local function ensureBox(player)
    if not espTracerGui then return nil end

    local data = espObjects[player]
    if not data then
        data = {}
        espObjects[player] = data
    end

    if data.box and data.box.Parent then
        return data.box
    end

    local box = makeBox(espTracerGui, getESPColor(player))
    box.Name = "ESPBox_" .. tostring(player.UserId)

    data.box = box
    return box
end

local function updateBox(box, minPoint, maxPoint, visible, color)
    if not box then return end

    if not visible or not minPoint or not maxPoint then
        box.Visible = false
        return
    end

    local width = maxPoint.X - minPoint.X
    local height = maxPoint.Y - minPoint.Y

    if width <= 2 or height <= 2 then
        box.Visible = false
        return
    end

    -- Keep the exact same tracking/bounds, but enlarge the displayed
    -- rectangle by 1.3x around its center.
    local centerX = (minPoint.X + maxPoint.X) * 0.5
    local centerY = (minPoint.Y + maxPoint.Y) * 0.5
    local scaledWidth = width * ESP_BOX_SCALE
    local scaledHeight = height * ESP_BOX_SCALE
    local scaledMinX = centerX - scaledWidth * 0.5
    local scaledMinY = centerY - scaledHeight * 0.5

    -- Update the complete rectangle as one object.
    box.Position = UDim2.fromOffset(scaledMinX, scaledMinY)
    box.Size = UDim2.fromOffset(scaledWidth, scaledHeight)

    local stroke = box:FindFirstChild("ESPBoxStroke")
    if stroke then
        stroke.Color = color
        stroke.Thickness = ESP_BOX_THICKNESS
        stroke.Transparency = 0
        stroke.Enabled = true
    end

    box.Visible = true
end

local function ensureTracer(player)
    if not espTracerGui then return nil end

    local data = espObjects[player]
    if not data then
        data = {}
        espObjects[player] = data
    end

    local tracerName = "PlayerESPTracer_" .. tostring(player.UserId)
    local existing = espTracerGui:FindFirstChild(tracerName)

    if existing and existing:IsA("Frame") then
        data.tracer = existing
        return existing
    end

    local line = Instance.new("Frame")
    line.Name = tracerName
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Size = UDim2.fromOffset(1, ESP_TRACER_THICKNESS)
    line.BackgroundColor3 = getESPColor(player)
    line.BackgroundTransparency = ESP_TRACER_TRANSPARENCY
    line.BorderSizePixel = 0
    line.Visible = false
    line.ZIndex = 2
    line.Parent = espTracerGui

    data.tracer = line
    return line
end

local function removeESPForPlayer(player)
    local data = espObjects[player]

    if data then
        if data.tracer then
            pcall(function()
                data.tracer:Destroy()
            end)
        end

        if data.box then
            pcall(function()
                data.box:Destroy()
            end)
        end
    end

    espObjects[player] = nil
end

local function setupESPPlayer(player)
    if player == LocalPlayer or espPlayerConnections[player] then
        return
    end

    local connections = {}
    espPlayerConnections[player] = connections

    table.insert(connections, player:GetPropertyChangedSignal("TeamColor"):Connect(function()
        local color = getESPColor(player)
        local data = espObjects[player]

        if data then
            if data.tracer then
                data.tracer.BackgroundColor3 = color
            end

            if data.box then
                local stroke = data.box:FindFirstChild("ESPBoxStroke")
                if stroke then
                    stroke.Color = color
                end
            end
        end
    end))

    espObjects[player] = espObjects[player] or {}
    ensureTracer(player)
end

local function updateTracerLine(line, fromPoint, toPoint, visible)
    if not line then return end

    if not visible then
        line.Visible = false
        return
    end

    local delta = toPoint - fromPoint
    local length = delta.Magnitude

    if length < 1 then
        line.Visible = false
        return
    end

    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Position = UDim2.fromOffset(
        (fromPoint.X + toPoint.X) * 0.5,
        (fromPoint.Y + toPoint.Y) * 0.5
    )
    line.Size = UDim2.fromOffset(length, ESP_TRACER_THICKNESS)
    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    line.Visible = true
end

local function startPlayerESP()
    if unloaded then return end

    if espTracerGui then
        pcall(function()
            espTracerGui:Destroy()
        end)
    end

    table.clear(espObjects)

    espTracerGui = Instance.new("ScreenGui")
    espTracerGui.Name = "PingFpsUI_PlayerESP_Tracers"
    espTracerGui.ResetOnSpawn = false
    espTracerGui.IgnoreGuiInset = true
    espTracerGui.DisplayOrder = 2
    espTracerGui.Parent = PlayerGui

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            setupESPPlayer(player)
        end
    end

    espPlayerConnections.__PlayerAdded = Players.PlayerAdded:Connect(function(player)
        if enabled.playeresp and not unloaded then
            setupESPPlayer(player)
        end
    end)

    espPlayerConnections.__PlayerRemoving = Players.PlayerRemoving:Connect(function(player)
        local connections = espPlayerConnections[player]

        if connections then
            for _, connection in ipairs(connections) do
                disconnectESPConnection(connection)
            end
            espPlayerConnections[player] = nil
        end

        removeESPForPlayer(player)
    end)

    espRenderConnection = RunService.RenderStepped:Connect(function()
        if not enabled.playeresp or unloaded then
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local viewport = camera.ViewportSize
        local showTracer = not enabled.hidetracers
        local showBox = true

        local startPoint = Vector2.new(viewport.X * 0.5, viewport.Y)

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local color = getESPColor(player)

                local data = espObjects[player]
                if not data then
                    setupESPPlayer(player)
                    data = espObjects[player]
                end

                -- Tracer
                local tracer = ensureTracer(player)

                if tracer then
                    if showTracer then
                        local root = getTracerRoot(character)

                        if root and root:IsA("BasePart") and root.Parent then
                            local sp, onScreen =
                                camera:WorldToViewportPoint(root.Position)

                            updateTracerLine(
                                tracer,
                                startPoint,
                                Vector2.new(sp.X, sp.Y),
                                onScreen and sp.Z > 0
                            )

                            tracer.BackgroundColor3 = color
                            tracer.BackgroundTransparency = ESP_TRACER_TRANSPARENCY
                        else
                            tracer.Visible = false
                        end
                    else
                        tracer.Visible = false
                    end
                end

                -- Single hitbox rectangle
                local box = ensureBox(player)

                if box and showBox and character then
                    local wMin, wMax = getCharacterBodyBounds(character)

                    if wMin and wMax then
                        local sxMin, syMin = math.huge, math.huge
                        local sxMax, syMax = -math.huge, -math.huge
                        local anyInFront = false

                        for _, cx in ipairs({wMin.X, wMax.X}) do
                            for _, cy in ipairs({wMin.Y, wMax.Y}) do
                                for _, cz in ipairs({wMin.Z, wMax.Z}) do
                                    local sp =
                                        camera:WorldToViewportPoint(
                                            Vector3.new(cx, cy, cz)
                                        )

                                    if sp.Z > 0 then
                                        anyInFront = true
                                    end

                                    sxMin = math.min(sxMin, sp.X)
                                    syMin = math.min(syMin, sp.Y)
                                    sxMax = math.max(sxMax, sp.X)
                                    syMax = math.max(syMax, sp.Y)
                                end
                            end
                        end

                        if anyInFront
                            and (sxMax - sxMin) > 2
                            and (syMax - syMin) > 2 then

                            updateBox(
                                box,
                                Vector2.new(sxMin, syMin),
                                Vector2.new(sxMax, syMax),
                                true,
                                color
                            )
                        else
                            updateBox(box, nil, nil, false, color)
                        end
                    else
                        updateBox(box, nil, nil, false, color)
                    end
                elseif box then
                    updateBox(box, nil, nil, false, color)
                end
            end
        end
    end)
end

local function stopPlayerESP()
    if espRenderConnection then
        disconnectESPConnection(espRenderConnection)
        espRenderConnection = nil
    end

    for key, connections in pairs(espPlayerConnections) do
        if type(key) ~= "string" then
            for _, connection in ipairs(connections) do
                disconnectESPConnection(connection)
            end
            espPlayerConnections[key] = nil
        end
    end

    if espPlayerConnections.__PlayerAdded then
        disconnectESPConnection(espPlayerConnections.__PlayerAdded)
        espPlayerConnections.__PlayerAdded = nil
    end

    if espPlayerConnections.__PlayerRemoving then
        disconnectESPConnection(espPlayerConnections.__PlayerRemoving)
        espPlayerConnections.__PlayerRemoving = nil
    end

    for player in pairs(espObjects) do
        removeESPForPlayer(player)
    end

    table.clear(espObjects)

    if espTracerGui then
        pcall(function()
            espTracerGui:Destroy()
        end)
        espTracerGui = nil
    end
end

local function applyPlayerESP(on)
    if GAME_FEATURES_LOCKED then
        on = false
    end
    if on then
        startPlayerESP()

        if hideTracersToggle then
            hideTracersToggle.Locked = false
            hideTracersToggle.Refresh()
        end
    else
        stopPlayerESP()

        enabled.hidetracers = false

        if hideTracersToggle then
            hideTracersToggle.Locked = true
            hideTracersToggle.Refresh()
        end
    end
end

-- Custom Max Zoom
local customZoomOriginalDistance = nil
local customZoomLastAppliedValue = nil

local function rememberCustomZoomOriginal()
    if LocalPlayer and customZoomOriginalDistance == nil then
        customZoomOriginalDistance = LocalPlayer.CameraMaxZoomDistance
    end
end

local function applyCustomMaxZoom()
    if unloaded or not LocalPlayer or not customZoomBox then
        return false
    end

    local value = tonumber(customZoomBox.Text)
    if not value then
        return false
    end

    value = math.clamp(value, 0.5, 10000)
    value = math.floor(value * 10 + 0.5) / 10

    rememberCustomZoomOriginal()

    local ok = pcall(function()
        LocalPlayer.CameraMaxZoomDistance = value
    end)

    if not ok then
        return false
    end

    customZoomLastAppliedValue = value
    customZoomBox.Text = tostring(value):gsub("%.0$", "")
    return true
end

local function restoreCustomMaxZoom()
    if LocalPlayer and customZoomOriginalDistance ~= nil then
        pcall(function()
            LocalPlayer.CameraMaxZoomDistance = customZoomOriginalDistance
        end)
    end
end
