-- Panel state: nil = both closed, "settings" = settings visible, "stats" = stats visible
local activePanel = nil
local panelTransitionId = 0

local settingsTweenHolder = {}
local statsTweenHolder = {}

local function cancelPanelTween(tweenRef)
    if tweenRef[1] then
        pcall(function() tweenRef[1]:Cancel() end)
        tweenRef[1] = nil
    end
end

local function slideIn(panel, tweenRef)
    cancelPanelTween(tweenRef)
    panel.Visible = true
    panel.Position = UDim2.new(0, PANEL_HIDDEN_X, 0, PANEL_Y_OFFSET)

    local t = TweenService:Create(panel, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, PANEL_VISIBLE_X, 0, PANEL_Y_OFFSET)
    })
    tweenRef[1] = t
    t.Completed:Connect(function(playbackState)
        if tweenRef[1] == t then
            tweenRef[1] = nil
        end
    end)
    t:Play()
end

local function slideOut(panel, tweenRef, onDone)
    cancelPanelTween(tweenRef)

    local t = TweenService:Create(panel, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0, PANEL_HIDDEN_X, 0, PANEL_Y_OFFSET)
    })
    tweenRef[1] = t
    local transitionId = panelTransitionId

    t.Completed:Connect(function(playbackState)
        if tweenRef[1] ~= t then return end
        tweenRef[1] = nil

        -- Cancelled tweens must never finish a panel swap.
        if playbackState ~= Enum.PlaybackState.Completed then return end

        panel.Visible = false
        if onDone and transitionId == panelTransitionId then
            onDone()
        end
    end)
    t:Play()
end

function setSettingsOpen(open)
    panelTransitionId += 1
    local thisTransition = panelTransitionId

    if open then
        if activePanel == "settings" and settingsMenu.Visible then return end

        activePanel = "transitioning"
        settingsOpen = false
        statsOpen = false

        -- Always stop/hide the other panel before opening Settings.
        if statsMenu.Visible or statsTweenHolder[1] then
            cancelPanelTween(statsTweenHolder)
            statsMenu.Visible = false
            statsMenu.Position = UDim2.new(0, PANEL_HIDDEN_X, 0, PANEL_Y_OFFSET)
        end

        collapseM1Expander()
        settingsOpen = true
        activePanel = "settings"
        if thisTransition == panelTransitionId then
            slideIn(settingsMenu, settingsTweenHolder)
        end
    else
        if activePanel ~= "settings" and not settingsMenu.Visible then return end

        activePanel = nil
        settingsOpen = false
        collapseM1Expander()
        slideOut(settingsMenu, settingsTweenHolder)
    end
end

function setStatsOpen(open)
    panelTransitionId += 1
    local thisTransition = panelTransitionId

    if open then
        if activePanel == "stats" and statsMenu.Visible then return end

        activePanel = "transitioning"
        settingsOpen = false
        statsOpen = false

        -- Always stop/hide the other panel before opening Statistics.
        if settingsMenu.Visible or settingsTweenHolder[1] then
            cancelPanelTween(settingsTweenHolder)
            settingsMenu.Visible = false
            settingsMenu.Position = UDim2.new(0, PANEL_HIDDEN_X, 0, PANEL_Y_OFFSET)
        end

        collapseM1Expander()
        statsOpen = true
        activePanel = "stats"
        if thisTransition == panelTransitionId then
            slideIn(statsMenu, statsTweenHolder)
        end
    else
        if activePanel ~= "stats" and not statsMenu.Visible then return end

        activePanel = nil
        statsOpen = false
        slideOut(statsMenu, statsTweenHolder)
    end
end

