        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = COLORS.white
        stroke.Transparency = 0.7
        stroke.Parent = button

        local clickTime = 0
        button.MouseButton1Click:Connect(function()
            local now = os.clock()
            if clickTime > 0 and now - clickTime <= 0.3 then
                removeM1Favorite(hex)
                refreshM1FavoritesDropdown()
                if #m1FavoriteColors == 0 then
                    m1FavoritesDropdown.Visible = false
                    m1FavoritesDropdownOpen = false
                end
                clickTime = 0
                return
            end
            clickTime = now

            local parsed = hexToColor3(hex)
            if parsed then
                currentM1Color = parsed
                m1HexBox.Text = hex
                persistM1Color(currentM1Color)
                if enabled.m1color then
                    refreshActiveVFXColor()
                end
            end
        end)
    end

    m1FavoritesDropdown.Size = UDim2.new(
        0,
        math.max(40, math.min(#m1FavoriteColors, 7) * (swatchWidth + swatchGap) + 4),
        0,
        rowHeight + 4
    )
