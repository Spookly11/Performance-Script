local function connectAwakeningCharacter(character)
    disconnectAwakeningCharacterConnections()

    if not character then
        updateAwakeningDisplay()
        return
    end

    table.insert(
        awakeningCharacterConnections,
        character:GetAttributeChangedSignal("Ulted"):Connect(function()
            if not unloaded then
                updateAwakeningDisplay()
            end
        end)
    )

    local function connectPrimaryPartFill()
        for i = #awakeningCharacterConnections, 1, -1 do
            local _connection = awakeningCharacterConnections[i]
            -- Only disconnect/rebuild the fill connection; the character
            -- Ulted connection is kept by rebuilding all character connections.
        end

        disconnectAwakeningCharacterConnections()

        table.insert(
            awakeningCharacterConnections,
            character:GetAttributeChangedSignal("Ulted"):Connect(function()
                if not unloaded then
                    updateAwakeningDisplay()
                end
            end)
        )

        local primaryPart = character.PrimaryPart
        if primaryPart then
            table.insert(
                awakeningCharacterConnections,
                primaryPart:GetAttributeChangedSignal("fill"):Connect(function()
                    if not unloaded and character:GetAttribute("Ulted") == true then
                        updateAwakeningDisplay()
                    end
                end)
            )
        end

        updateAwakeningDisplay()
    end

    connectPrimaryPartFill()

    table.insert(
        awakeningCharacterConnections,
        character:GetPropertyChangedSignal("PrimaryPart"):Connect(function()
            if not unloaded then
                connectPrimaryPartFill()
            end
        end)
    )
end

