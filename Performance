-- Only create the built-in chat UI when Roblox says the local player
-- is actually permitted to use experience text chat.
local function playerCanUseChat()
    local ok, canChat = pcall(function()
        return TextChatService:CanUserChatAsync(LocalPlayer.UserId)
    end)

    return ok and canChat == true
end

local function disableNativeChatUI()
    nativeChatWindowConfiguration = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
    nativeChatInputBarConfiguration = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")

    if nativeChatWindowConfiguration then
        nativeChatWindowEnabled = nativeChatWindowConfiguration.Enabled
        pcall(function()
            nativeChatWindowConfiguration.Enabled = false
        end)
    end

    if nativeChatInputBarConfiguration then
        nativeChatInputEnabled = nativeChatInputBarConfiguration.Enabled
        pcall(function()
            nativeChatInputBarConfiguration.Enabled = false
        end)
    end
end

local function restoreNativeChatUI()
    if nativeChatWindowConfiguration and nativeChatWindowConfiguration.Parent and nativeChatWindowEnabled ~= nil then
        pcall(function()
            nativeChatWindowConfiguration.Enabled = nativeChatWindowEnabled
        end)
    end

    if nativeChatInputBarConfiguration and nativeChatInputBarConfiguration.Parent and nativeChatInputEnabled ~= nil then
        pcall(function()
            nativeChatInputBarConfiguration.Enabled = nativeChatInputEnabled
        end)
    end

    nativeChatWindowConfiguration = nil
    nativeChatInputBarConfiguration = nil
    nativeChatWindowEnabled = nil
    nativeChatInputEnabled = nil
end

if playerCanUseChat() then
    disableNativeChatUI()
